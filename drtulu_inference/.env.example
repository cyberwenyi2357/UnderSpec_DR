# Required API Keys
SERPER_API_KEY=your_serper_key   # [Must have] Needed for serper search - https://serper.dev/
S2_API_KEY=your_s2_key           # Needed for snippet search - https://api.semanticscholar.org/
JINA_API_KEY=your_jina_key       # Needed for jina-based browsing tool - https://jina.ai/reader/

# Needed for GPT-5.4 as the search agent (workflows/auto_search_sft-gpt5.4.yaml)
# and for the ask_user simulator (gpt-5.4-mini) in both workflows
OPENAI_API_KEY=your_openai_key

# Optional: JSONL log for each generate_with_tools (user_prompt + gpt_response). Path is
# relative to the process working directory if not absolute.
LLM_RESPONSE_LOG_JSON=llm_responses.jsonl
ASK_USER_LOG_FULL_PROMPT=1
